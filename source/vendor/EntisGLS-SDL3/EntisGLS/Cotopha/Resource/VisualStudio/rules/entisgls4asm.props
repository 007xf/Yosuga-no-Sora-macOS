<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup
    Condition="'$(MASMforEntisGLSBeforeTargets)' == '' and '$(MASMforEntisGLSAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <MASMforEntisGLSBeforeTargets>Midl</MASMforEntisGLSBeforeTargets>
    <MASMforEntisGLSAfterTargets>CustomBuild</MASMforEntisGLSAfterTargets>
  </PropertyGroup>
  <PropertyGroup>
    <MASMforEntisGLSDependsOn
      Condition="'$(ConfigurationType)' != 'Makefile'">_SelectedFiles;$(MASMforEntisGLSDependsOn)</MASMforEntisGLSDependsOn>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <MASMforEntisGLS>
      <DebugMode>False</DebugMode>
      <WarningLevel>0</WarningLevel>
      <CommandLineTemplate>"$(MASM)\ml.exe" /nologo /c /Cp /coff [AllOptions] [AdditionalOptions] /Fo"$(IntDir)%(Filename).obj" /Ta [inputs]</CommandLineTemplate>
      <Outputs>$(IntDir)%(Filename).obj</Outputs>
      <ExecutionDescription>Assembling...</ExecutionDescription>
      <ShowOnlyRuleProperties>true</ShowOnlyRuleProperties>
    </MASMforEntisGLS>
  </ItemDefinitionGroup>
</Project>